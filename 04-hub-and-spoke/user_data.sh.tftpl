#!/bin/bash
# Cada servidor prueba el ping hacia los demás y publica el resultado en una página web.
command -v ping >/dev/null 2>&1 || dnf install -y iputils

mkdir -p /srv/www
cat > /opt/probe.sh <<'EOS'
#!/bin/bash
while true; do
  {
    echo "<html><head><meta charset='UTF-8'><meta http-equiv='refresh' content='10'></head><body><pre style='font-size:18px'>"
    echo "Servidor: ${name}  (${self_ip})"
    date
    echo ""
    for t in ${targets}; do
      if ping -c 2 -W 2 $t >/dev/null 2>&1; then
        echo "ping a $t : ALCANZABLE"
      else
        echo "ping a $t : BLOQUEADO"
      fi
    done
    echo "</pre></body></html>"
  } > /srv/www/index.html.tmp
  mv /srv/www/index.html.tmp /srv/www/index.html
  sleep 10
done
EOS
chmod +x /opt/probe.sh

nohup /opt/probe.sh > /var/log/probe.log 2>&1 &
cd /srv/www
nohup python3 -m http.server 80 > /var/log/web.log 2>&1 &
